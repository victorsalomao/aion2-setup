# Endereço final do site, sem barra no fim. Usado em canonical, hreflang e sitemap.
SITE_URL=https://seu-dominio.com

# ID do AdSense (ca-pub-...). Vazio = nenhum script de anúncio é carregado.
PUBLIC_ADSENSE_CLIENT=

# "1" mostra caixas no lugar dos anúncios em desenvolvimento, para conferir o layout.
PUBLIC_SHOW_AD_PLACEHOLDERS=1
