---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
const tt = t('pt');
---
<Base lang="pt" title={tt('notfound.title')} description={tt('notfound.title')} noindex hasTranslation={false}>
  <section class="block">
    <h1>{tt('notfound.title')}</h1>
    <p><a href="/">{tt('notfound.back')}</a> · <a href="/en/">Back to home</a></p>
  </section>
</Base>
