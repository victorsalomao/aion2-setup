---
/** Pontuação do Rito no Hard a partir do tempo que sobrou. A fórmula mora em src/lib/rite.ts. */
import { RITE_DIFFICULTIES } from '../lib/rite';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const hard = RITE_DIFFICULTIES.find((d) => d.id === 'hard')!;
const copy = {
  pt: { locale: 'pt-BR', title: 'Sua run no Hard', min: 'Minutos que sobraram', sec: 'Segundos', out: 'Pontuação: <b>{score}</b>. Cristais da conquista nessa pontuação: <b>{crystals}</b>.' },
  en: { locale: 'en', title: 'Your Hard run', min: 'Minutes left', sec: 'Seconds', out: 'Score: <b>{score}</b>. Achievement crystals at that score: <b>{crystals}</b>.' },
}[lang];
---
<div class="panel" data-rite data-base={hard.base} data-per-second={hard.perSecond} data-copy={JSON.stringify(copy)}>
  <h3>{copy.title}</h3>
  <div class="field">
    <label for="rite-min">{copy.min}</label>
    <input type="number" id="rite-min" min="0" max="59" value="10" inputmode="numeric" />
    <label for="rite-sec">{copy.sec}</label>
    <input type="number" id="rite-sec" min="0" max="59" value="34" inputmode="numeric" />
  </div>
  <p class="result" data-out aria-live="polite"></p>
</div>

<script>
  import { riteScore, CRYSTAL_MILESTONES } from '../lib/rite';

  document.querySelectorAll<HTMLElement>('[data-rite]').forEach((root) => {
    const copy = JSON.parse(root.dataset.copy || '{}');
    const base = Number(root.dataset.base);
    const perSecond = Number(root.dataset.perSecond);
    const min = root.querySelector<HTMLInputElement>('#rite-min')!;
    const sec = root.querySelector<HTMLInputElement>('#rite-sec')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const paint = () => {
      const left = Math.max(0, Number(min.value) || 0) * 60 + Math.max(0, Number(sec.value) || 0);
      const score = riteScore(base, perSecond, left);
      const crystals = CRYSTAL_MILESTONES.filter((m) => score >= m).length;
      out.innerHTML = copy.out
        .replace('{score}', score.toLocaleString(copy.locale))
        .replace('{crystals}', String(crystals));
    };
    min.addEventListener('input', paint);
    sec.addEventListener('input', paint);
    paint();
  });
</script>
