---
import { t, tr, type Lang, type L10n } from '../i18n';

interface Props {
  lang: Lang;
  name: string;
  mono: string;
  category: string;
  level: number | string;
  spec?: L10n;
  role: L10n;
  changed?: boolean;
}
const { lang, name, mono, category, level, spec, role, changed = false } = Astro.props;
---
<article class:list={['skill', { changed }]}>
  <div class:list={['mono', `cat-${category}`]} aria-hidden="true">{mono}</div>
  <div class="skill-body">
    <div class="skill-head">
      <span class="skill-name">{name}</span>
      <span class="lv">{t(lang)('class.level')} {level}</span>
    </div>
    {spec && <span class="skill-spec">{tr(spec, lang)}</span>}
    <span class="skill-role">{tr(role, lang)}</span>
  </div>
</article>
